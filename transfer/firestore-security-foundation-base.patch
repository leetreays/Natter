diff --git a/firestore.rules b/firestore.rules
new file mode 100644
index 0000000..1e19132
--- /dev/null
+++ b/firestore.rules
@@ -0,0 +1,154 @@
+rules_version = '2';
+service cloud.firestore {
+  match /databases/{database}/documents {
+
+    function signedIn() {
+      return request.auth != null;
+    }
+
+    function isParent(parentId) {
+      return signedIn() && request.auth.uid == parentId;
+    }
+
+    function childDoc(parentId, childId) {
+      return /databases/$(database)/documents/parents/$(parentId)/children/$(childId);
+    }
+
+    function isLinkedChild(parentId, childId) {
+      return signedIn()
+        && exists(childDoc(parentId, childId))
+        && get(childDoc(parentId, childId)).data.linkedAuthUid == request.auth.uid;
+    }
+
+    function isLinkedParticipantAt(conversation, index) {
+      return signedIn()
+        && conversation.participantChildIds is list
+        && conversation.participantParentIds is list
+        && conversation.participantChildIds.size() > index
+        && conversation.participantParentIds.size() > index
+        && isLinkedChild(
+          conversation.participantParentIds[index],
+          conversation.participantChildIds[index]
+        );
+    }
+
+    function isLinkedConversationParticipant(conversation) {
+      return isLinkedParticipantAt(conversation, 0)
+        || isLinkedParticipantAt(conversation, 1);
+    }
+
+    function conversationParticipantsUnchanged() {
+      return request.resource.data.participantChildIds
+          == resource.data.participantChildIds
+        && request.resource.data.participantParentIds
+          == resource.data.participantParentIds;
+    }
+
+    function childLinkageUnchanged() {
+      return request.resource.data.linkedAuthUid
+          == resource.data.linkedAuthUid
+        && request.resource.data.linkedDevice == resource.data.linkedDevice;
+    }
+
+    function childLinkageResetOnly() {
+      return request.resource.data.diff(resource.data).affectedKeys()
+          .hasOnly(['linkedAuthUid', 'linkedDevice'])
+        && request.resource.data.linkedAuthUid == null
+        && request.resource.data.linkedDevice == false;
+    }
+
+    function conversationData(conversationId) {
+      return get(
+        /databases/$(database)/documents/conversations/$(conversationId)
+      ).data;
+    }
+
+    match /parents/{parentId} {
+      allow read, write: if isParent(parentId);
+
+      match /children/{childId} {
+        allow read: if isParent(parentId) || isLinkedChild(parentId, childId);
+        allow create: if isParent(parentId);
+
+        allow update: if (
+          isParent(parentId) || isLinkedChild(parentId, childId)
+        ) && (childLinkageUnchanged() || childLinkageResetOnly());
+
+        allow delete: if isParent(parentId);
+
+        match /chats/{chatId} {
+          allow read, write: if isParent(parentId) || isLinkedChild(parentId, childId);
+
+          match /messages/{messageId} {
+            allow read, write: if isParent(parentId) || isLinkedChild(parentId, childId);
+          }
+        }
+
+        match /contact_requests/{requestId} {
+          allow read, write: if isParent(parentId) || isLinkedChild(parentId, childId);
+        }
+
+        match /approved_contacts/{contactId} {
+          allow read, write: if isParent(parentId) || isLinkedChild(parentId, childId);
+        }
+
+        match /signals/{signalId} {
+          allow read, write: if isParent(parentId) || isLinkedChild(parentId, childId);
+        }
+      }
+    }
+
+    match /child_access_codes/{code} {
+      allow get: if signedIn();
+      allow list: if false;
+      allow write: if signedIn();
+    }
+
+    match /child_friend_codes/{code} {
+      allow read, write: if signedIn();
+    }
+
+    match /friend_requests/{requestId} {
+      allow create: if false;
+      allow read: if signedIn();
+      allow update: if false;
+      allow delete: if false;
+    }
+
+    match /friendships/{friendshipId} {
+      allow read, write: if signedIn();
+
+      match /{document=**} {
+        allow read, write: if signedIn();
+      }
+    }
+
+    match /conversations/{conversationId} {
+      allow create: if false;
+      allow delete: if false;
+
+      allow read: if isLinkedConversationParticipant(resource.data);
+      allow update: if signedIn() && conversationParticipantsUnchanged();
+
+      match /messages/{messageId} {
+        allow create: if signedIn();
+        allow read: if isLinkedConversationParticipant(
+          conversationData(conversationId)
+        );
+        allow update: if signedIn();
+        allow delete: if false;
+      }
+
+      match /meaningful_moments/{momentId} {
+        allow create: if signedIn();
+        allow read: if signedIn();
+        allow update: if signedIn();
+        allow delete: if false;
+      }
+    }
+
+    match /users/{uid} {
+      allow read, write: if signedIn() && request.auth.uid == uid;
+    }
+  }
+}
