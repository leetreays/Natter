{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "test:projection-unit": "node --test test/message-projection.test.js",
    "test:projection-emulator": "node --test test/message-projection.emulator.test.js",
    "test:projection": "npm run test:projection-unit && npm run test:projection-emulator",
    "test:projection-backfill-unit": "node --test test/conversation-projection-backfill.test.js",
    "test:projection-backfill-emulator": "node --test test/conversation-projection-backfill.emulator.test.js",
    "backfill:projection": "node backfill/conversation-projection-backfill.js",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.4.1"
  },
  "private": true
}
